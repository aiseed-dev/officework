[Desktop Entry]
Name=officework
Comment=Native spreadsheet and word processor with honest xlsx/docx round-trip
Comment[ja]=xlsx と docx を壊さないネイティブの表計算とワープロ
Exec=officework %f
Icon=io.github.aiseed_dev.officework
Terminal=false
Type=Application
Categories=Office;Spreadsheet;WordProcessor;
MimeType=application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;application/vnd.openxmlformats-officedocument.wordprocessingml.document;text/x-asciidoc;text/csv;
