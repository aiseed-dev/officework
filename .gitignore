target/
vendor/

# 機械ごとの設定。絶対パスや symlink が入るので追跡しない
.cargo/
.linklibs/
# miniforge の仮想環境(pandas 連携の検証用)
.venv/

# 手元に残すが、公開するものではない
core/
demo.html
index.html
logo.svg

# 検証で出るもの
*.pdf
lang/corpus/txt/
# e-shop 試作の生成物(正本は sample/カタログ.docx — eshop.py が作り直す)
sample/商品マスタ.csv

# 開いている印(排他ロック)。閉じれば消える — 決して追跡しない
.~lock.*
__pycache__/

# 組んだ Python 拡張(cargo build -p pysheet → コピー)。配るのは wheel の側
pysheet/officework/_sheet*.so

# 本文のフォントは同梱しない(システムから探す)
assets/
tools/__pycache__/

# 並走セッションの worktree(repo の中に作られる)
.worktrees/

# 実機の点検で撮った絵の置き場(ribbon_sweep.py・lang_check.py)
scratch/
packaging/out/
packaging/cache/
pysheet/officework/bin/
# 見本の写真と、それを埋めた台帳は生成物(sample/写真の台帳.py が作る)。
# **実物大の JPEG を追跡に入れない** — 作り直せる 3MB を git に置く理由が無い
# (他の見本の xlsx は手で組んだ小さい物なので追跡している)
sample/写真/
sample/写真の台帳.xlsx
# 便りの下書きは生成物(sample/月の便り.py が作る)。宛先が入るので追跡しない
sample/便りの下書き/
sample/会員申込.html
sample/site/
