.cargo/
.linklibs/
# miniforge の仮想環境(pandas 連携の検証用)
.venv/

# 手元に残すが、公開するものではない
core/
demo.html
index.html
logo.svg

# 検証で出るもの
*.pdf
lang/corpus/txt/
