pysheet/officework/_sheet*.so

# 本文のフォントは同梱しない(システムから探す)
assets/
tools/__pycache__/

# 並走セッションの worktree(repo の中に作られる)
.worktrees/

# 実機の点検で撮った絵の置き場(ribbon_sweep.py・lang_check.py)
scratch/
packaging/out/
packaging/cache/
pysheet/officework/bin/
