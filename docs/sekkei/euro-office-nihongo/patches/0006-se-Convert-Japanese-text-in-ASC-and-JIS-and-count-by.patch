diff --git a/cell/model/FormulaObjects/textanddataFunctions.js b/cell/model/FormulaObjects/textanddataFunctions.js
index 2a9e1c4..7e8a9d0 100644
--- a/cell/model/FormulaObjects/textanddataFunctions.js
+++ b/cell/model/FormulaObjects/textanddataFunctions.js
@@ -68,10 +68,177 @@ function (window, undefined) {
 		cTRIM, cUNICHAR, cUNICODE, cUPPER, cVALUE, cTEXTBEFORE, cTEXTAFTER, cTEXTSPLIT);
 
 	cFormulaFunctionGroup['NotRealised'] = cFormulaFunctionGroup['NotRealised'] || [];
-	cFormulaFunctionGroup['NotRealised'].push(cBAHTTEXT, cJIS, cPHONETIC);
+	cFormulaFunctionGroup['NotRealised'].push(cBAHTTEXT, cPHONETIC);
 
 	const MAX_UNSIGNED_INT_16 = 65535;
 
+	// Full-width and half-width forms for ASC and JIS (ECMA-376 Part 1,
+	// 18.17.7.11 and 18.17.7.187): ASC("エクセル") is ｴｸｾﾙ and JIS("ｴｸｾﾙ")
+	// is エクセル. A voiced kana is one full-width character and two
+	// half-width ones (ガ, ｶﾞ).
+	const HALF_VOICED = '\uFF9E', HALF_SEMI_VOICED = '\uFF9F';
+	let halfToFullKana = null, fullToHalfKana = null;
+	function initKanaTables() {
+		if (halfToFullKana) {
+			return;
+		}
+		halfToFullKana = {};
+		fullToHalfKana = {};
+		for (let code = 0xFF61; code <= 0xFF9F; code++) {
+			let half = String.fromCharCode(code);
+			let full = half.normalize('NFKC');
+			if (HALF_VOICED === half) {
+				full = '\u309B';
+			} else if (HALF_SEMI_VOICED === half) {
+				full = '\u309C';
+			}
+			halfToFullKana[half] = full;
+			fullToHalfKana[full] = half;
+		}
+	}
+	function toHalfWidth(str) {
+		initKanaTables();
+		let res = '';
+		for (let i = 0; i < str.length; i++) {
+			let ch = str[i], code = str.charCodeAt(i);
+			if (code >= 0xFF01 && code <= 0xFF5E) {
+				// ￥ is the yen sign at 0x5C in Japanese; it becomes \, as in code page 932
+				res += String.fromCharCode(code - 0xFEE0);
+			} else if (0xFFE5 === code) {
+				res += '\\';
+			} else if (0x3000 === code) {
+				res += ' ';
+			} else if (fullToHalfKana[ch]) {
+				res += fullToHalfKana[ch];
+			} else {
+				let parts = ch.normalize('NFD');
+				if (2 === parts.length && fullToHalfKana[parts[0]] && ('\u3099' === parts[1] || '\u309A' === parts[1])) {
+					res += fullToHalfKana[parts[0]] + ('\u3099' === parts[1] ? HALF_VOICED : HALF_SEMI_VOICED);
+				} else {
+					res += ch;
+				}
+			}
+		}
+		return res;
+	}
+	function toFullWidth(str) {
+		initKanaTables();
+		let res = '';
+		for (let i = 0; i < str.length; i++) {
+			let ch = str[i], code = str.charCodeAt(i);
+			if (0x5C === code) {
+				res += '\uFFE5';
+			} else if (code >= 0x21 && code <= 0x7E) {
+				res += String.fromCharCode(code + 0xFEE0);
+			} else if (0x20 === code) {
+				res += '\u3000';
+			} else if (halfToFullKana[ch]) {
+				let full = halfToFullKana[ch], next = str[i + 1];
+				if (HALF_VOICED === next || HALF_SEMI_VOICED === next) {
+					let voiced = (full + (HALF_VOICED === next ? '\u3099' : '\u309A')).normalize('NFC');
+					if (1 === voiced.length) {
+						full = voiced;
+						i++;
+					}
+				}
+				res += full;
+			} else {
+				res += ch;
+			}
+		}
+		return res;
+	}
+
+	// Bytes of text in the double-byte character set of Japanese (code page
+	// 932), for LENB and the other B functions (ECMA-376 Part 1, 18.17.7.194):
+	// ASCII and half-width katakana take one byte, other characters two
+	function getCharBytes(code) {
+		return code <= 0x7F || (code >= 0xFF61 && code <= 0xFF9F) ? 1 : 2;
+	}
+	// The characters of str with the byte each one starts at
+	function getByteChars(str) {
+		let chars = [], bytes = 0;
+		for (let i = 0; i < str.length; i++) {
+			let code = str.charCodeAt(i), ch = str[i];
+			if (code >= 0xD800 && code <= 0xDBFF && i + 1 < str.length) {
+				ch += str[++i];
+			}
+			let size = getCharBytes(code);
+			chars.push({ch: ch, start: bytes, size: size, index: i + 1 - ch.length});
+			bytes += size;
+		}
+		return {chars: chars, length: bytes};
+	}
+	function getByteLength(str) {
+		return getByteChars(str).length;
+	}
+	// The bytes [start, start + count) of str; half of a two-byte character
+	// at either end becomes a space
+	function sliceBytes(str, start, count) {
+		let res = '', end = start + count;
+		let chars = getByteChars(str).chars;
+		for (let i = 0; i < chars.length; i++) {
+			let c = chars[i], from = Math.max(start, c.start), to = Math.min(end, c.start + c.size);
+			if (to <= from) {
+				continue;
+			}
+			res += to - from === c.size ? c.ch : ' '.repeat(to - from);
+		}
+		return res;
+	}
+	// The character index at a byte position, and back
+	function byteToCharIndex(str, byte) {
+		let chars = getByteChars(str).chars;
+		for (let i = 0; i < chars.length; i++) {
+			if (chars[i].start + chars[i].size > byte) {
+				return chars[i].index;
+			}
+		}
+		return str.length;
+	}
+	function charToByteIndex(str, index) {
+		return getByteLength(str.substring(0, index));
+	}
+	// The text of an argument that is one value
+	function getSingleText(arg, cross) {
+		if (arg instanceof cArea || arg instanceof cArea3D) {
+			arg = arg.cross(cross);
+		} else if (arg instanceof cRef || arg instanceof cRef3D) {
+			arg = arg.getValue();
+		}
+		if (arg instanceof cArray) {
+			arg = arg.getElementRowCol(0, 0);
+		}
+		return arg instanceof cError ? null : arg.toLocaleString();
+	}
+	// FINDB and SEARCHB: the start is a byte and so is the result
+	function findBytes(func, arg, cross) {
+		let within = getSingleText(arg[1], cross);
+		if (null === within || [arg[0], arg[1], arg[2]].some(function (a) { return a instanceof cArray; })) {
+			return func.call(this, arg, cross);
+		}
+		let args = arg.slice();
+		if (args.length > 2) {
+			let start = args[2];
+			if (start instanceof cArea || start instanceof cArea3D) {
+				start = start.cross(cross);
+			}
+			start = start.tocNumber();
+			if (start instanceof cError) {
+				return start;
+			}
+			if (start.getValue() < 1) {
+				return new cError(cErrorType.wrong_value_type);
+			}
+			args[2] = new cNumber(byteToCharIndex(within, start.getValue() - 1) + 1);
+		}
+		let res = func.call(this, args, cross);
+		if (res instanceof cNumber) {
+			res = new cNumber(charToByteIndex(within, res.getValue() - 1) + 1);
+		}
+		return res;
+	}
+
 	function calcBeforeAfterText(arg, arg1, isAfter) {
 		let newArgs = cBaseFunction.prototype._prepareArguments.call(this, arg, arg1, null, null, true).args;
 		let text = newArgs[0];
@@ -356,19 +523,7 @@ function (window, undefined) {
 		var arg0 = arg[0];
 
 		var calcAsc = function (str) {
-			var res = '';
-			var fullWidthFrom = 0xFF00;
-			var fullWidthTo = 0xFFEF;
-
-			for (var i = 0; i < str.length; i++) {
-				var nCh = str[i].charCodeAt(0);
-				if (nCh >= fullWidthFrom && nCh <= fullWidthTo) {
-					nCh = 0xFF & (nCh + 0x20);
-				}
-				res += String.fromCharCode(nCh);
-			}
-
-			return new cString(res);
+			return new cString(toHalfWidth(str));
 		};
 
 		if (arg0 instanceof cArea || arg0 instanceof cArea3D) {
@@ -1040,6 +1195,9 @@ function (window, undefined) {
 	cFINDB.prototype.constructor = cFINDB;
 	cFINDB.prototype.name = 'FINDB';
 	cFINDB.prototype.argumentsType = [argType.text, argType.text, argType.number];
+	cFINDB.prototype.Calculate = function (arg) {
+		return findBytes.call(this, cFIND.prototype.Calculate, arg, arguments[1]);
+	};
 
 	/**
 	 * @constructor
@@ -1393,19 +1551,7 @@ function (window, undefined) {
 		var arg0 = arg[0];
 
 		var calc = function (str) {
-			var res = '';
-			var fullWidthFrom = 0xFF00;
-			var fullWidthTo = 0xFFEF;
-
-			for (var i = 0; i < str.length; i++) {
-				var nCh = str[i].charCodeAt(0);
-				if (!(nCh >= fullWidthFrom && nCh <= fullWidthTo)) {
-					nCh = nCh - 0x20 + 0xff00;
-				}
-				res += String.fromCharCode(nCh);
-			}
-
-			return new cString(res);
+			return new cString(toFullWidth(str));
 		};
 
 		if (arg0 instanceof cArea || arg0 instanceof cArea3D) {
@@ -1495,6 +1641,27 @@ function (window, undefined) {
 	cLEFTB.prototype.constructor = cLEFTB;
 	cLEFTB.prototype.name = 'LEFTB';
 	cLEFTB.prototype.argumentsType = [argType.text, argType.number];
+	cLEFTB.prototype.Calculate = function (arg) {
+		let res = cLEFT.prototype.Calculate.call(this, [arg[0], new cNumber(Number.MAX_SAFE_INTEGER)], arguments[1]);
+		let count = arg.length === 1 ? new cNumber(1) : arg[1];
+		if (count instanceof cArea || count instanceof cArea3D) {
+			count = count.cross(arguments[1]);
+		}
+		count = count.tocNumber();
+		if (count instanceof cArray) {
+			count = count.getElementRowCol(0, 0);
+		}
+		if (!(res instanceof cString)) {
+			return res;
+		}
+		if (count instanceof cError) {
+			return count;
+		}
+		if (count.getValue() < 0) {
+			return new cError(cErrorType.wrong_value_type);
+		}
+		return new cString(sliceBytes(res.getValue(), 0, Math.floor(count.getValue())));
+	};
 
 	/**
 	 * @constructor
@@ -1540,6 +1707,13 @@ function (window, undefined) {
 	cLENB.prototype.constructor = cLENB;
 	cLENB.prototype.name = 'LENB';
 	cLENB.prototype.argumentsType = [argType.text];
+	cLENB.prototype.Calculate = function (arg) {
+		let str = getSingleText(arg[0], arguments[1]);
+		if (null === str) {
+			return cLEN.prototype.Calculate.call(this, arg, arguments[1]);
+		}
+		return new cNumber(getByteLength(str));
+	};
 
 	/**
 	 * @constructor
@@ -1661,6 +1835,37 @@ function (window, undefined) {
 	cMIDB.prototype = Object.create(cMID.prototype);
 	cMIDB.prototype.constructor = cMIDB;
 	cMIDB.prototype.name = 'MIDB';
+	cMIDB.prototype.Calculate = function (arg) {
+		let str = getSingleText(arg[0], arguments[1]);
+		let start = arg[1], count = arg[2];
+		if (start instanceof cArea || start instanceof cArea3D) {
+			start = start.cross(arguments[1]);
+		}
+		if (count instanceof cArea || count instanceof cArea3D) {
+			count = count.cross(arguments[1]);
+		}
+		start = start.tocNumber();
+		count = count.tocNumber();
+		if (start instanceof cArray) {
+			start = start.getElementRowCol(0, 0);
+		}
+		if (count instanceof cArray) {
+			count = count.getElementRowCol(0, 0);
+		}
+		if (null === str) {
+			return cMID.prototype.Calculate.call(this, arg, arguments[1]);
+		}
+		if (start instanceof cError) {
+			return start;
+		}
+		if (count instanceof cError) {
+			return count;
+		}
+		if (start.getValue() < 1 || count.getValue() < 0) {
+			return new cError(cErrorType.wrong_value_type);
+		}
+		return new cString(sliceBytes(str, Math.floor(start.getValue()) - 1, Math.floor(count.getValue())));
+	};
 
 	/**
 	 * @constructor
@@ -1958,6 +2163,28 @@ function (window, undefined) {
 	cREPLACEB.prototype.constructor = cREPLACEB;
 	cREPLACEB.prototype.name = 'REPLACEB';
 	cREPLACEB.prototype.argumentsType = [argType.text, argType.number, argType.number, argType.text];
+	cREPLACEB.prototype.Calculate = function (arg) {
+		let str = getSingleText(arg[0], arguments[1]);
+		if (null === str) {
+			return cREPLACE.prototype.Calculate.call(this, arg, arguments[1]);
+		}
+		// REPLACE with the character positions of the bytes
+		let res = cREPLACE.prototype.Calculate.call(this, [new cString(str), arg[1], arg[2], arg[3]], arguments[1]);
+		if (!(res instanceof cString)) {
+			return res;
+		}
+		let start = arg[1], count = arg[2];
+		if (start instanceof cArea || start instanceof cArea3D) {
+			start = start.cross(arguments[1]);
+		}
+		if (count instanceof cArea || count instanceof cArea3D) {
+			count = count.cross(arguments[1]);
+		}
+		start = Math.floor(start.tocNumber().getValue()) - 1;
+		count = Math.floor(count.tocNumber().getValue());
+		let total = getByteLength(str), newText = getSingleText(arg[3], arguments[1]) || '';
+		return new cString(sliceBytes(str, 0, start) + newText + sliceBytes(str, start + count, Math.max(0, total - start - count)));
+	};
 
 	/**
 	 * @constructor
@@ -2082,6 +2309,28 @@ function (window, undefined) {
 	cRIGHTB.prototype.constructor = cRIGHTB;
 	cRIGHTB.prototype.name = 'RIGHTB';
 	cRIGHTB.prototype.argumentsType = [argType.text, argType.number];
+	cRIGHTB.prototype.Calculate = function (arg) {
+		let res = cRIGHT.prototype.Calculate.call(this, [arg[0], new cNumber(Number.MAX_SAFE_INTEGER)], arguments[1]);
+		let count = arg.length === 1 ? new cNumber(1) : arg[1];
+		if (count instanceof cArea || count instanceof cArea3D) {
+			count = count.cross(arguments[1]);
+		}
+		count = count.tocNumber();
+		if (count instanceof cArray) {
+			count = count.getElementRowCol(0, 0);
+		}
+		if (!(res instanceof cString)) {
+			return res;
+		}
+		if (count instanceof cError) {
+			return count;
+		}
+		if (count.getValue() < 0) {
+			return new cError(cErrorType.wrong_value_type);
+		}
+		let str = res.getValue(), total = getByteLength(str), n = Math.min(total, Math.floor(count.getValue()));
+		return new cString(sliceBytes(str, total - n, n));
+	};
 
 	/**
 	 * @constructor
@@ -3079,6 +3328,9 @@ function (window, undefined) {
 	cSEARCHB.prototype.constructor = cSEARCHB;
 	cSEARCHB.prototype.name = 'SEARCHB';
 	cSEARCHB.prototype.argumentsType = [argType.text, argType.text, argType.number];
+	cSEARCHB.prototype.Calculate = function (arg) {
+		return findBytes.call(this, cSEARCH.prototype.Calculate, arg, arguments[1]);
+	};
 
 	/**
 	 * @constructor
@@ -3574,6 +3826,10 @@ function (window, undefined) {
 		}
 
 		var res = g_oFormatParser.parse(arg0.getValue());
