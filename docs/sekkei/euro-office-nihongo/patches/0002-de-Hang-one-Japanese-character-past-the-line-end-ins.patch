@@ -5275,6 +5283,8 @@ ParaRun.prototype.Recalculate_Range_Width = function(PRSC, _CurLine, _CurRange)
 
                 PRSC.SpaceLen = 0;
 
+				PRSC.LastHangW = (para_Text === ItemType && Item.IsEastAsianHangingAllowed()) ? Item.GetWidth(textPr) : 0;
+
                 // Пробелы перед первым словом в строке не считаем
                 if (PRSC.Words > 1)
                     PRSC.Spaces += PRSC.SpacesCount;
