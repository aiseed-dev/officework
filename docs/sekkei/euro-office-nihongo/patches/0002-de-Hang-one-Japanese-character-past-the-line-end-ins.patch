diff --git a/tests/word/document-calculation/paragraph/paragraph-lines.js b/tests/word/document-calculation/paragraph/paragraph-lines.js
index cbf8359..547fc6d 100644
--- a/tests/word/document-calculation/paragraph/paragraph-lines.js
+++ b/tests/word/document-calculation/paragraph/paragraph-lines.js
@@ -182,6 +182,38 @@ $(function () {
 			"ステム"
 		]);
 		
+		// Punctuation that may not begin a line stays at the end of the previous
+		// line, past the margin (one character only)
+		setText("漢字漢字漢字漢。漢字漢字");
+		recalculate(charWidth * 7.5);
+		checkLines(assert, para, [
+			"漢字漢字漢字漢。",
+			"漢字漢字"
+		]);
+		
+		setText("漢字漢字漢字漢」漢字漢字");
+		recalculate(charWidth * 7.5);
+		checkLines(assert, para, [
+			"漢字漢字漢字漢」",
+			"漢字漢字"
+		]);
+		
+		// Only one character hangs: with two, the break moves back
+		setText("漢字漢字漢字漢。」漢字");
+		recalculate(charWidth * 7.5);
+		checkLines(assert, para, [
+			"漢字漢字漢字",
+			"漢。」漢字"
+		]);
+		
+		// An opening bracket may not end a line
+		setText("漢字漢字漢字「漢字漢字」");
+		recalculate(charWidth * 7.5);
+		checkLines(assert, para, [
+			"漢字漢字漢字",
+			"「漢字漢字」"
+		]);
+		
 		// A full stop never begins a line, even after a run of kana
 		setText("東京にすんでいます。わたしはがくせいです。");
 		recalculate(charWidth * 8.5);
@@ -201,6 +233,20 @@ $(function () {
 		]);
 	});
 	
+	QUnit.test("Test hanging punctuation is left out of the alignment", function (assert)
+	{
+		setText("漢字漢字漢字漢。漢字漢字漢字漢字漢字");
+		for (let jc of [AscCommon.align_Left, AscCommon.align_Justify, AscCommon.align_Center, AscCommon.align_Right])
+		{
+			para.SetParagraphAlign(jc);
+			recalculate(charWidth * 7);
+			let range = para.Lines[0].Ranges[0];
+			assert.close(range.XVisible, 0, 0.001, "The line starts at the left edge, jc = " + jc);
+			assert.close(range.XEndVisible, charWidth * 8, 0.001, "The full stop hangs one character past the edge, jc = " + jc);
+		}
+		para.SetParagraphAlign(AscCommon.align_Left);
+	});
+	
 	QUnit.test("Test: \"Test paragraph with very narrow width\"", function (assert)
 	{
 		assert.strictEqual(dc.GetElementsCount(), 1, "Paragraphs count");
