diff --git a/word/Editor/Paragraph_Recalculate.js b/word/Editor/Paragraph_Recalculate.js
index 04c6cfb..296ecd9 100644
--- a/word/Editor/Paragraph_Recalculate.js
+++ b/word/Editor/Paragraph_Recalculate.js
@@ -1996,6 +1996,11 @@ Paragraph.prototype.private_RecalculateLineAlign       = function(CurLine, CurPa
 			}
 			else
 			{
+				// A character hanging past the line end (see ParaRun.Recalculate_Range) stays in the margin:
+				// the line is aligned and justified without it, so the other characters keep their places
+				let hangW = (!bRtlAlign && PRSC.LastHangW > 0 && Range.W > RangeWidth) ? PRSC.LastHangW : 0;
+				Range.W -= hangW;
+				
 				// RangeWidth - ширина всего пространства в данном отрезке, а Range.W - ширина занимаемого пространства
 				switch (jc)
 				{
@@ -2130,6 +2135,8 @@ Paragraph.prototype.private_RecalculateLineAlign       = function(CurLine, CurPa
 						break;
 					}
 				}
+				
+				Range.W += hangW;
 			}
 		}
 		
@@ -4397,6 +4404,7 @@ function CParagraphRecalculateStateCounter(wrapState)
     this.Letters     = 0;
     this.SpacesSkip  = 0;
     this.LettersSkip = 0;
+	this.LastHangW   = 0; // Width of the last letter of the range when it may hang past the line end
 
     this.ComplexFields = new AscWord.ParagraphComplexFieldStack();
 }
@@ -4413,6 +4421,7 @@ CParagraphRecalculateStateCounter.prototype.Reset = function(Paragraph, Range)
