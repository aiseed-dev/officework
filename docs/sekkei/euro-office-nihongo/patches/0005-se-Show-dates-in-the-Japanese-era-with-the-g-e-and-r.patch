--- a/common/NumFormat.js
+++ b/common/NumFormat.js
@@ -71,6 +71,11 @@ var numFormat_AmPm = 19;
 var numFormat_DateSeparator = 20;
 var numFormat_TimeSeparator = 21;
 var numFormat_DecimalPointText = 22;
+// Japanese era (ECMA-376 Part 1, 18.8.31, International Considerations):
+// g/gg/ggg is the era name, e/ee the year in the era; r is ee and rr gggee
+var numFormat_Era = 23;
+var numFormat_EraYear = 24;
+var numFormat_EraR = 25;
 //Helper types that will be replaced in _prepareFormat
 var numFormat_MonthMinute = 101;
 var numFormat_Percent = 102;
@@ -206,6 +211,26 @@ function FormatObjDecimalFrac(aLeft, aRight)
 	this.numerator = 0;
 	this.denominator = 0;
 }
+// Start of each era in the Gregorian calendar, newest first
+var g_aJapaneseEras = [
+	{year: 2019, month: 5, day: 1, name: "令和", initial: "R"},
+	{year: 1989, month: 1, day: 8, name: "平成", initial: "H"},
+	{year: 1926, month: 12, day: 25, name: "昭和", initial: "S"},
+	{year: 1912, month: 7, day: 30, name: "大正", initial: "T"},
+	{year: 1868, month: 10, day: 23, name: "明治", initial: "M"}
+];
+// The era of a date (month from 0), or null before the first era
+function getJapaneseEra(year, month, day)
+{
+	var key = year * 10000 + (month + 1) * 100 + day;
+	for (var i = 0; i < g_aJapaneseEras.length; ++i)
+	{
+		var era = g_aJapaneseEras[i];
+		if (key >= era.year * 10000 + era.month * 100 + era.day)
+			return {name: era.name, initial: era.initial, year: year - era.year + 1};
+	}
+	return null;
+}
 function FormatObjDateVal(type, nCount, bElapsed)
 {
     this.type = type;
@@ -930,6 +955,27 @@ NumFormat.prototype =
                     var sign = ("+" == nextnext) ? SignType.Positive : SignType.Negative;
                     this._addToFormat2(new FormatObjScientific(next, "", sign));
                 }
+                else
+                {
+                    // Not a scientific format: e is the year in the Japanese era
+                    if(this.EOF != nextnext)
+                        this._skip(-1);
+                    this._addToFormat2(new FormatObjDateVal(numFormat_EraYear, 1, false));
+                }
+            }
+            else if(("G" == next || "g" == next) && "/標準" === this._GetText(3))
+            {
+                // G/標準 is General in Japanese
+                this._addToFormat(numFormat_General);
+                this._skip(3);
+            }
+            else if("G" == next || "g" == next)
+            {
+                this._addToFormat2(new FormatObjDateVal(numFormat_Era, 1, false));
+            }
+            else if("R" == next || "r" == next)
+            {
+                this._addToFormat2(new FormatObjDateVal(numFormat_EraR, 1, false));
             }
             else if("*" == next)
             {
@@ -1151,7 +1197,7 @@ NumFormat.prototype =
                 }
             }
             else if(numFormat_Year == item.type || numFormat_MonthMinute == item.type || numFormat_Month == item.type || numFormat_Day == item.type || numFormat_Hour == item.type || numFormat_Minute == item.type || numFormat_Second == item.type || numFormat_Thousand == item.type ||
-				numFormat_DayOfWeek == item.type)
+				numFormat_DayOfWeek == item.type || numFormat_Era == item.type || numFormat_EraYear == item.type || numFormat_EraR == item.type)
             {
                 //Combine hhh sequences into one
                 var nStartType = item.type;
@@ -1170,12 +1216,24 @@ NumFormat.prototype =
                     this.aRawFormat.splice(i + 1, nDelCount);
                     nFormatLength -= nDelCount;
                 }
+                if(numFormat_EraR == item.type)
+                {
+                    // r is ee and rr is gggee
+                    var aEra = [new FormatObjDateVal(numFormat_EraYear, 2, false)];
+                    if(item.val > 1)
+                        aEra.unshift(new FormatObjDateVal(numFormat_Era, 3, false));
+                    this.aRawFormat.splice.apply(this.aRawFormat, [i, 1].concat(aEra));
+                    nFormatLength += aEra.length - 1;
+                    i += aEra.length - 1;
+                    item = this.aRawFormat[i];
+                }
                 if(numFormat_Thousand != item.type)
                 {
                     this.bDateTime = true;
                     if(numFormat_Hour == item.type || numFormat_Minute == item.type || numFormat_Second == item.type || numFormat_Milliseconds == item.type)
                         this.bTime = true;
-                    else if (numFormat_Year == item.type || numFormat_Month == item.type || numFormat_Day == item.type) {
+                    else if (numFormat_Year == item.type || numFormat_Month == item.type || numFormat_Day == item.type ||
+                        numFormat_Era == item.type || numFormat_EraYear == item.type) {
                         this.bDate = true;
                         if (numFormat_Day == item.type)
                             this.bDay = true;
@@ -1335,7 +1393,8 @@ NumFormat.prototype =
                     {
                         var subItem = this.aRawFormat[j];
                         if(numFormat_Year == subItem.type || numFormat_Month == subItem.type || numFormat_Day == subItem.type || numFormat_MonthMinute == subItem.type ||
-                        numFormat_Hour == subItem.type || numFormat_Minute == subItem.type || numFormat_Second == subItem.type || numFormat_Milliseconds == subItem.type)
+                        numFormat_Hour == subItem.type || numFormat_Minute == subItem.type || numFormat_Second == subItem.type || numFormat_Milliseconds == subItem.type ||
+                        numFormat_Era == subItem.type || numFormat_EraYear == subItem.type)
                         {
                             if(numFormat_Second == subItem.type)
                                 bRightCond = true;
@@ -1368,7 +1427,8 @@ NumFormat.prototype =
                                 bFindSec = false;
                             break;
                         }
-                        else if(numFormat_Year == subItem.type || numFormat_Day == subItem.type || numFormat_Hour == subItem.type || numFormat_Second == subItem.type || numFormat_Milliseconds == subItem.type)
+                        else if(numFormat_Year == subItem.type || numFormat_Day == subItem.type || numFormat_Hour == subItem.type || numFormat_Second == subItem.type || numFormat_Milliseconds == subItem.type ||
+                            numFormat_Era == subItem.type || numFormat_EraYear == subItem.type)
                         {
                             if(true == bFindSec)
                                 break;
@@ -1997,6 +2057,10 @@ NumFormat.prototype =
 							if (null != item.Lid) {
 								//Excel sometimes add 0x10000(0x442 and 0x10442)
 								this.LCID = parseInt(item.Lid, 16) & 0xFFFF;
+								// Excel writes [$-ja-JP-x-gannen] for the Japanese era with 元年; the
+								// bracket keeps only "ja" of it
+								if (/^ja$/i.test(item.Lid))
+									this.LCID = 0x411;
 							}
 						}
                     }
@@ -2116,6 +2180,9 @@ NumFormat.prototype =
         if (null != this.LCID) {
             cultureInfoLCID = g_aCultureInfos[this.LCID] || cultureInfo;
         }
+        // The era codes follow the ja-jp locale: the format's [$-411], or the
+        // workbook's when the format names none
+        var isJapanese = 0x411 === (null != this.LCID ? this.LCID : cultureInfo.LCID);
         if(null == nValType)
             nValType = CellValueType.Number;
         var res = [];
@@ -2331,6 +2398,28 @@ NumFormat.prototype =
 						oCurText.text += 'a'.repeat(item.val);
 					}
 				}
+                else if(numFormat_Era == item.type || numFormat_EraYear == item.type)
+                {
+                    var date = oParsedNumber.date;
+                    var era = isJapanese ? getJapaneseEra(date.year, date.month, date.d) : null;
+                    if (numFormat_Era == item.type)
+                    {
+                        // g: the initial, gg: the first kanji, ggg: the name
+                        if (era)
+                            oCurText.text += 1 === item.val ? era.initial : (2 === item.val ? era.name[0] : era.name);
+                    }
+                    else
+                    {
+                        checkRLM();
+                        if (era)
+                            oCurText.text += item.val > 1 ? this._ZeroPad(era.year) : era.year;
+                        else if (item.val > 1)
+                            // Outside ja-jp, ee is yy and e is yyyy
+                            oCurText.text += date.year.toString().slice(-2);
+                        else
+                            oCurText.text += date.year;
+                    }
+                }
                 else if(numFormat_Year == item.type)
                 {
                   if (item.val > 0) {
@@ -2778,6 +2867,10 @@ NumFormat.prototype =
 				for(var j = 0; j < nIndex; ++j)
 					res += dayOfWeek;
 			}
+			else if(numFormat_Era == item.type)
+				res += "g".repeat(item.val);
+			else if(numFormat_EraYear == item.type)
+				res += "e".repeat(item.val);
             else if(numFormat_AmPm == item.type)
                 res += "AM/PM";
             else if(numFormat_Milliseconds == item.type)
