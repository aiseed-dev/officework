+    QUnit.test('Japanese era formats', function (assert) {
+        // ECMA-376 Part 1, 18.8.31 (International Considerations) and the
+        // ja-jp built-in formats of 18.8.30 (ids 27, 28, 36, 50, 51 ...)
+        const ja = AscCommon.g_aCultureInfos[1041];
+        const en = AscCommon.g_aCultureInfos[1033];
+        let testCases = [
+            [46301, '[$-411]ggge"年"m"月"d"日"', ja, '令和8年10月6日'],
+            [46301, '[$-411]ge.m.d', ja, 'R8.10.6'],
+            [46301, '[$-411]gge"."m"."d', ja, '令8.10.6'],
+            [46301, '[$-411]ggg ee"年"', ja, '令和 08年'],
+            [46301, '[$-411]rr"年"', ja, '令和08年'],
+            [46301, '[$-411]r', ja, '08'],
+            // Excel names the language with a tag here
+            [46301, '[$-ja-JP-x-gannen]ggge"年"m"月"d"日";@', ja, '令和8年10月6日'],
+            // The era changes on its first day
+            [43585, '[$-411]ggge"年"m"月"d"日"', ja, '平成31年4月30日'],
+            [43586, '[$-411]ggge"年"m"月"d"日"', ja, '令和1年5月1日'],
+            [32515, '[$-411]ggge"年"m"月"d"日"', ja, '昭和64年1月7日'],
+            [32516, '[$-411]ge.m.d', ja, 'H1.1.8'],
+            [9856, '[$-411]ggge"年"', ja, '昭和1年'],
+            [4594, '[$-411]ggge"年"', ja, '明治45年'],
+            [4595, '[$-411]gge"年"', ja, '大1年'],
+            // Without [$-411] the workbook's locale decides; outside ja-jp
+            // e is yyyy and ee is yy
+            [46301, 'ggge"年"m"月"d"日"', ja, '令和8年10月6日'],
+            [46301, 'e/m/d', en, '2026/10/6'],
+            [46301, 'ee/mm/dd', en, '26/10/06'],
+            [46301, '[$-411]aaaa', en, '火曜日'],
+            // E+ and E- stay scientific, and G/標準 is General
+            [46301, '0.00E+00', ja, '4.63E+04'],
+            [46301, '0.0e-0', ja, '4.6e4'],
+            [46301.5, 'G/標準', ja, '46301.5'],
+        ];
+        for (let i = 0; i < testCases.length; i++) {
+            let [value, format, culture, expected] = testCases[i];
+            let formatted = new AscCommon.CellFormat(format).format(value, undefined, undefined, undefined, culture);
+            let text = formatted.map(function (part) { return part.text; }).join('');
+            assert.strictEqual(text, expected, `format("${format}", ${value})`);
+        }
+    });
+
     QUnit.test('date/time elapsed formats', function (assert) {
         let testCases = [
             // Date format cases
