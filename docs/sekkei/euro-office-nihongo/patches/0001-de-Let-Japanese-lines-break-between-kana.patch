From d322f57b430448cc9cbfb5860a9366ef97e41eea Mon Sep 17 00:00:00 2001
From: Yasuhiro Niji <ysniji@gmail.com>
Date: Tue, 6 Oct 2026 07:21:50 +0900
Subject: [PATCH 1/3] [de] Let Japanese lines break between kana

isEastAsianPunctuation() covered U+3000-U+4DB5, which takes in all of
Hiragana and Katakana, and IsSpaceBefore() / IsSpaceAfter() refused a
break on both sides of every character in that range. A run of kana
was therefore laid out like one Latin word and moved to the next line
as a whole, so lines ended several characters early. The same run could
reach the long-word fallback, which split it without the kinsoku checks
and put a full stop at the start of a line.

The directional checks CanBeAtBeginOfLine() / CanBeAtEndOfLine() already
keep closing and opening punctuation in place, so the punctuation test
is dropped from the two break predicates and the range is narrowed to
the CJK Symbols and Punctuation block. Hangul keeps its exclusion.

This is the change proposed upstream in ONLYOFFICE/sdkjs#4885 by
zeptometer, with tests added.

Assisted-by: ClaudeCode:claude-opus-5-5
---
 common/editorscommon.js                       |  2 +-
 .../paragraph/paragraph-lines.js              | 37 +++++++++++++++++++
 word/Editor/Paragraph/RunContent/Text.js      |  6 +--
 3 files changed, 40 insertions(+), 5 deletions(-)

diff --git a/common/editorscommon.js b/common/editorscommon.js
index 15e9b9f..868576b 100644
--- a/common/editorscommon.js
+++ b/common/editorscommon.js
@@ -11910,7 +11910,7 @@
 	
 	function isEastAsianPunctuation(value)
 	{
-		return (0x3000 <= value && value <= 0x4DB5);
+		return (0x3000 <= value && value <= 0x303F);
 	}
 
 	function IsHangul(nCharCode)
diff --git a/tests/word/document-calculation/paragraph/paragraph-lines.js b/tests/word/document-calculation/paragraph/paragraph-lines.js
index 78476f7..cbf8359 100644
--- a/tests/word/document-calculation/paragraph/paragraph-lines.js
+++ b/tests/word/document-calculation/paragraph/paragraph-lines.js
@@ -164,6 +164,43 @@ $(function () {
 	});
 	
 
+	QUnit.test("Test line breaks for Japanese text", function (assert)
+	{
+		// A line may break between any two kana, as between ideographs
+		setText("漢字ですあいうえおかきくけこさしす");
+		recalculate(charWidth * 8.5);
+		checkLines(assert, para, [
+			"漢字ですあいうえ",
+			"おかきくけこさし",
+			"す"
+		]);
+		
+		setText("コンピューターシステム");
+		recalculate(charWidth * 8.5);
+		checkLines(assert, para, [
+			"コンピューターシ",
+			"ステム"
+		]);
+		
+		// A full stop never begins a line, even after a run of kana
+		setText("東京にすんでいます。わたしはがくせいです。");
+		recalculate(charWidth * 8.5);
+		checkLines(assert, para, [
+			"東京にすんでいま",
+			"す。わたしはがく",
+			"せいです。"
+		]);
+		
+		// A line may break after Japanese punctuation that comes before Latin text
+		setText("日本語、Officeは便利です");
+		recalculate(charWidth * 8.5);
+		checkLines(assert, para, [
+			"日本語、",
+			"Officeは便",
+			"利です"
+		]);
+	});
+	
 	QUnit.test("Test: \"Test paragraph with very narrow width\"", function (assert)
 	{
 		assert.strictEqual(dc.GetElementsCount(), 1, "Paragraphs count");
diff --git a/word/Editor/Paragraph/RunContent/Text.js b/word/Editor/Paragraph/RunContent/Text.js
index de2ee8f..d6e1832 100644
--- a/word/Editor/Paragraph/RunContent/Text.js
+++ b/word/Editor/Paragraph/RunContent/Text.js
@@ -474,8 +474,7 @@
 	CRunText.prototype.IsSpaceBefore = function(fontHint)
 	{
 		return ((AscCommon.isEastAsianScript(this.Value)
-				&& !AscCommon.isHangul(this.Value)
-				&& !AscCommon.isEastAsianPunctuation(this.Value))
+				&& !AscCommon.isHangul(this.Value))
 			|| (AscWord.fonthint_EastAsia === fontHint && AscCommon.isAmbiguousCharacter(this.Value)));
 	};
 	CRunText.prototype.isHyphenAfter = function()
@@ -566,8 +565,7 @@
 		
 		return (AscCommon.isEastAsianScript(this.Value)
 			&& this.CanBeAtEndOfLine()
-			&& !AscCommon.isHangul(this.Value)
-			&& !AscCommon.isEastAsianPunctuation(this.Value));
+			&& !AscCommon.isHangul(this.Value));
 	};
 	CRunText.prototype.CanBeAtBeginOfLine = function()
 	{
